# Email delivery for the contact/booking form (https://resend.com)
# Without this set, the form still works but returns an honest "not configured"
# error with a call/WhatsApp fallback instead of a fake success.
RESEND_API_KEY=

# Absolute site URL, used for canonical links, sitemap, and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
