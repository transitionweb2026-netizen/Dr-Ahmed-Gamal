# Email delivery for the contact/booking form (https://resend.com)
# Without this set, the form still works but returns an honest "not configured"
# error with a call/WhatsApp fallback instead of a fake success.
RESEND_API_KEY=

# Absolute site URL, used for canonical links, sitemap, and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase CMS backend (https://supabase.com — Project Settings > API).
# Without these set, every page falls back to the bundled static content in
# src/content/*.ts and messages/*.json, and /admin is unreachable — the
# public site keeps working either way.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, bypasses Row Level Security. Never expose
# this to the browser or commit it. Used by admin Server Actions to write
# CMS data (Settings > API > service_role secret).
SUPABASE_SERVICE_ROLE_KEY=
